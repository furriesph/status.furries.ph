{
  "name": "@furriesph/status",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "react-router dev --host 127.0.0.1 --port 4430",
    "build": "react-router build",
    "preview": "vite preview --host 127.0.0.1 --port 4430",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "monitor": "node --env-file-if-exists=.env.monitor.local --env-file-if-exists=.env.cloudflare.local scripts/collect-status.mjs",
    "monitor:watch": "node scripts/watch-status.mjs",
    "validate:data": "node scripts/validate-status.mjs"
  },
  "dependencies": {
    "isbot": "^5",
    "lucide-react": "^1.37.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@react-router/dev": "^8.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.2.2"
  }
}
