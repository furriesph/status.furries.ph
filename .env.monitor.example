# Collector-only. Copy to .env.monitor.local (gitignored). Never use VITE_ prefixes here.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy fallback, only when the project uses service-role JWT keys.
SUPABASE_SERVICE_ROLE_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WORKER_NAME=partners-api
CLOUDFLARE_ZONE_ID=
# Optional operating budgets. When blank, the collector publishes actual daily
# Worker usage with the live Standard no-daily-cap rule and derives the Standard
# monthly included request allotment.
# Set only if you need a lower internal alert budget.
CLOUDFLARE_DAILY_REQUEST_LIMIT=
CLOUDFLARE_MONTHLY_REQUEST_LIMIT=
STATUS_SLOW_RESPONSE_MS=3000
GAS_EMAIL_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=
# Local-only opt-in to existing encrypted Wrangler auth; never enabled in CI.
LOCAL_CLOUDFLARE_AUTH=
# Optional local file populated by trusted service health producers. Array of records.
STATUS_HEALTH_SIGNALS_FILE=
